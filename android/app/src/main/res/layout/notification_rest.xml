<?xml version="1.0" encoding="utf-8"?>
<!-- Pushimi gjatë seancës (V2-E1-08, bordi "Seanca · Njoftimi"): kronometri i Android-it numëron poshtë
     vetë ("Pushimi mbaron për 0:45"), edhe kur procesi i app-it fle. "Kapërce pushimin" e vizaton
     sistemi si veprim i njoftimit. Shiriti i bordit mungon: Android-i nuk e lëviz vetë, dhe një
     përditësim çdo sekondë do ta mbante app-in zgjuar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="40dp"
    android:orientation="horizontal">

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_notification_timer" />

    <Chronometer
        android:id="@+id/rest_countdown"
        style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFeatureSettings="tnum"
        android:singleLine="true"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
