<?xml version="1.0" encoding="utf-8"?>
<!-- Rreshti i muzikës te njoftimi i seancës (V29, V2-E1-16a), nën "Ruaj setin" (music_slot): kënga dhe
     artisti, pastaj vetëm kontrollet që app-i i muzikës pranon (mbrapa, luaj/pauzë, para), si mini-player-i
     i seancës. Butonat 48 dp, me sfondin e −/+ (notification_key), që ndjek sfondin e njoftimit.
     SessionMusic.java e mbush. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/music_title"
            style="@style/TextAppearance.Compat.Notification.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/music_artist"
            style="@style/TextAppearance.Compat.Notification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/music_previous"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/notification_key"
        android:scaleType="center"
        android:src="@drawable/ic_notification_previous" />

    <ImageButton
        android:id="@+id/music_play_pause"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/notification_key"
        android:scaleType="center"
        android:src="@drawable/ic_notification_play" />

    <ImageButton
        android:id="@+id/music_next"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/notification_key"
        android:scaleType="center"
        android:src="@drawable/ic_notification_next" />
</LinearLayout>
