<?xml version="1.0" encoding="utf-8"?>
<!-- App-i i muzikës vetëm për provën në emulator (scripts/android-smoke.mjs): një sesion medie me tri
     këngë, pa zë, që Vrull e lexon dhe e kontrollon si Spotify-n. Shërbimi në plan të parë e mban procesin
     gjallë (pa të Android-i e ngrin dhe komandat e Vrullit presin). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application android:label="@string/app_name" android:allowBackup="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".PlayerService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
